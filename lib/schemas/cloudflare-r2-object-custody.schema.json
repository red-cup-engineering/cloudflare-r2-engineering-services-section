{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emsenn:schema:cloudflare-r2-object-custody:v1",
  "title": "Cloudflare R2 object custody boundary carriers",
  "$defs": {
    "caip10": {
      "type": "string",
      "pattern": "^eip155:[1-9][0-9]*:0x[0-9a-fA-F]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "niSha256": {
      "type": "string",
      "pattern": "^ni:///sha-256;[A-Za-z0-9_-]{42}[AEIMQUYcgkosw048]$"
    },
    "objectId": {
      "description": "UUIDv8 derived from the first 128 bits of sha256 with RFC variant/version bits set; sha256 remains the collision check.",
      "type": "string",
      "pattern": "^urn:uuid:[a-f0-9]{8}-[a-f0-9]{4}-8[a-f0-9]{3}-[89ab][a-f0-9]{3}-[a-f0-9]{12}$"
    },
    "sourceGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "sourcePath", "effects", "sha256", "byteLength", "expiresAt", "legacyAssetsExcluded"],
      "properties": {
        "type": { "const": "ExactFilesystemReadGrant" },
        "sourcePath": { "type": "string", "pattern": "^/" },
        "effects": { "const": ["lstat", "read"] },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1048576, "maximum": 5363466240 },
        "expiresAt": { "type": "string", "format": "date-time" },
        "legacyAssetsExcluded": { "const": true }
      }
    },
    "knowledge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "contentDigest", "sha256", "byteLength", "mediaType", "custody", "etag", "disposition", "carriesBytes"],
      "properties": {
        "type": { "const": "BucketObjectKnowledge" },
        "id": { "$ref": "#/$defs/objectId" },
        "contentDigest": { "$ref": "#/$defs/niSha256" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "byteLength": { "type": "integer", "minimum": 1048576, "maximum": 5363466240 },
        "mediaType": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "custody": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider", "contract", "storageClass", "customer"],
          "properties": {
            "provider": { "const": "urn:ame:cloudflare-r2-services-section" },
            "contract": { "const": "cloudflare-r2-object-custody/v1" },
            "storageClass": { "const": "Standard" },
            "customer": { "$ref": "#/$defs/caip10" }
          }
        },
        "etag": { "type": ["string", "null"] },
        "disposition": { "enum": ["stored-new-object", "reused-existing-object", "reused-concurrent-object"] },
        "carriesBytes": { "const": false }
      }
    },
    "storeRequest": {
      "type": "object",
      "required": ["type", "operation", "customer", "caller", "parentEffect", "mediaType", "expiresAt", "sourceGrant", "accountWideBillableUsage"],
      "properties": {
        "type": { "const": "CloudflareR2ObjectCustodyRequest" },
        "operation": { "const": "store" },
        "customer": { "type": "string", "pattern": "^urn:ame:[a-z0-9][a-z0-9.-]*$" },
        "caller": { "$ref": "#/$defs/caip10" },
        "parentEffect": { "oneOf": [{ "$ref": "#/$defs/niSha256" }, { "type": "null" }] },
        "mediaType": { "type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "sourceGrant": { "$ref": "#/$defs/sourceGrant" },
        "accountWideBillableUsage": { "type": "object" }
      }
    },
    "readRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "operation", "customer", "caller", "parentEffect", "expiresAt", "expiresInSeconds", "knowledge", "accountWideBillableUsage"],
      "properties": {
        "type": { "const": "CloudflareR2ObjectReadCapabilityRequest" },
        "operation": { "const": "issue-read-capability" },
        "customer": { "type": "string", "pattern": "^urn:ame:[a-z0-9][a-z0-9.-]*$" },
        "caller": { "$ref": "#/$defs/caip10" },
        "parentEffect": { "oneOf": [{ "$ref": "#/$defs/niSha256" }, { "type": "null" }] },
        "expiresAt": { "type": "string", "format": "date-time" },
        "expiresInSeconds": { "type": "integer", "minimum": 1, "maximum": 900 },
        "knowledge": { "$ref": "#/$defs/knowledge" },
        "accountWideBillableUsage": { "type": "object" }
      }
    },
    "readCapability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "object", "method", "url", "expiresAt", "bearer", "durable", "mustNotBeRecorded"],
      "properties": {
        "type": { "const": "EphemeralBucketObjectReadCapability" },
        "object": { "$ref": "#/$defs/objectId" },
        "method": { "const": "GET" },
        "url": { "type": "string", "format": "uri" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "bearer": { "const": true },
        "durable": { "const": false },
        "mustNotBeRecorded": { "const": true }
      }
    }
  },
  "oneOf": [
    { "$ref": "#/$defs/storeRequest" },
    { "$ref": "#/$defs/readRequest" },
    { "$ref": "#/$defs/knowledge" },
    { "$ref": "#/$defs/readCapability" }
  ]
}
